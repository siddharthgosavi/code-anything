{
  "name": "everything-opencode",
  "version": "1.0.0",
  "description": "The complete collection of OpenCode coding agent configs: agents, skills, hooks, commands, rules, and Graphify code intelligence.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "everything-opencode": "./bin/cli.js",
    "opencode-everything": "./bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./plugin": "./src/plugin/index.js",
    "./agents": "./src/agents/index.js",
    "./commands": "./src/commands/index.js"
  },
  "files": [
    "bin",
    "src",
    "agents",
    "commands",
    "contexts",
    "examples",
    "hooks",
    "mcp-configs",
    "plugins",
    "rules",
    "scripts",
    "skills",
    "templates",
    "LICENSE",
    "README.md",
    "FLAWS_FIXED.md",
    "WORLDFLOWAI.md"
  ],
  "scripts": {
    "test": "node tests/run-all.js && node tests/lib/utils.test.js && node tests/lib/package-manager.test.js && node tests/hooks/hooks.test.js",
    "start": "node bin/cli.js",
    "doctor": "node bin/cli.js doctor",
    "graphify": "node bin/cli.js graphify"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "graphify",
    "ai-agent",
    "coding-agent",
    "developer-tools"
